# ──────────────────────────────────────────────────────────────
# SPECTRA 4.1 — Environment Variables Template
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Supabase (free tier — no credit card required for demo) ───
# 1. Go to https://supabase.com and create a FREE project
# 2. In your project: Settings → API
# 3. Copy "Project URL" → SUPABASE_URL
# 4. Copy "anon public" key → SUPABASE_ANON_KEY
# 5. Run the schema: Supabase Dashboard → SQL Editor → paste Backend/db/schema.sql
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ── Optional: Supabase Service Role key (for admin writes) ─────
# Only needed if you run the ML pipeline to write results to DB.
# Keep this SECRET — never expose in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App settings ───────────────────────────────────────────────
APP_ENV=development        # development | production
APP_PORT=8000
LOG_LEVEL=info

# ── CORS origins (comma-separated) ────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
